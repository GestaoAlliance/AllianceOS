{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/mcp/oauth-protected-resource",
      "destination": "/api/brand-icon?mode=mcp-resource"
    },
    {
      "source": "/mcp",
      "destination": "/api/brand-icon?mode=mcp"
    },
    {
      "source": "/favicon.ico",
      "destination": "/api/brand-icon?v=20260922-4"
    },
    {
      "source": "/favicon.png",
      "destination": "/api/brand-icon?v=20260922-4"
    },
    {
      "source": "/icon-192.png",
      "destination": "/api/brand-icon?v=20260922-4"
    },
    {
      "source": "/icon-512.png",
      "destination": "/api/brand-icon?v=20260922-4"
    },
    {
      "source": "/manifest.webmanifest",
      "destination": "/api/manifest?v=20260922-4"
    },
    {
      "source": "/oauth/consent",
      "destination": "/"
    },
    {
      "source": "/login",
      "destination": "/"
    },
    {
      "source": "/cadastro",
      "destination": "/"
    }
  ]
}
